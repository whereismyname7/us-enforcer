@startuml context
!include <C4/C4_Context>

title Story Readiness Gate - System Context (C4 Level 1)
LAYOUT_WITH_LEGEND()

Person(ba, "Business Analyst", "Writes user stories and Change Requests")
Person(developer, "Developer", "Picks L4 stories from the board")
Person(architect, "Architect", "Maintains the rules and the target's containers")

System(gate, "Story Readiness Gate", "Grades every story L0 to L4 against the team's own architecture")
System_Ext(jira, "Jira", "Stories, CRs, the workflow and the board. Simulated by jira-sim in this proof of concept.")

Rel(ba, jira, "Writes stories and CRs in")
Rel(developer, jira, "Picks L4 stories from")
Rel(architect, gate, "Maintains rules and architecture of")
Rel(jira, gate, "Sends webhooks to", "HTTP")
Rel(gate, jira, "Reads stories and CRs, writes the level and a comment", "Jira REST API")

@enduml
