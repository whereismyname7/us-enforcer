@startuml containers
!include <C4/C4_Container>

title Story Readiness Gate - Containers (C4 Level 2)
LAYOUT_WITH_LEGEND()

Person(ba, "Business Analyst", "Writes stories and CRs")
Person(developer, "Developer", "Picks L4 stories")
System_Ext(jira, "Jira", "Simulated by jira-sim: stories, CRs, the L4 gate, the board")

System_Boundary(srg, "Story Readiness Gate") {
  Container(gateway, "Gateway", "nginx", "The only door in. Routes and API key. No business rules.")
  Container(intake, "Intake", "Node.js", "Anti-corruption layer: translates Jira fields, adds CR data, publishes StoryChanged")
  Container(checker, "Checker", "Node.js", "Checks a story against the rules and the target's containers and ADRs. Owns rules.yaml")
  Container(reporter, "Reporter", "Node.js", "Turns results into L0-L4 and is the only writer to Jira")
  ContainerDb(events, "Event Log", "Redpanda, Kafka protocol", "readiness.story-changes and readiness.check-results")
}

Rel(ba, jira, "Writes stories and CRs", "browser")
Rel(developer, jira, "Reads the board", "browser")
Rel(developer, gateway, "GET /v1/stories/{key}/readiness", "HTTP, X-Api-Key")
Rel(jira, gateway, "POST /webhook", "HTTP")
Rel(gateway, intake, "Routes /webhook", "HTTP")
Rel(gateway, reporter, "Routes the readiness API", "HTTP")
Rel(intake, jira, "Reads the story and its CR", "Jira REST")
Rel(intake, events, "Writes StoryChanged", "Kafka protocol")
Rel(checker, events, "Reads StoryChanged, writes StoryChecked", "Kafka protocol")
Rel(reporter, events, "Reads StoryChecked", "Kafka protocol")
Rel(reporter, jira, "Writes the level and a comment", "Jira REST")

@enduml
