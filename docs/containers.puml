@startuml containers
!include <C4/C4_Container>

title Story Readiness Gate - Containers (C4 Level 2)
skinparam linetype polyline
HIDE_STEREOTYPE()

Person(ba, "Business Analyst", "Writes stories and CRs")
System_Ext(jira, "Jira", "Stories, CRs, the L4 gate and the board. Simulated by jira-sim")
Person(dev, "Developer", "Picks L4 stories")
Person(architect, "Architect", "Owns the rules and the target architecture")

System_Boundary(srg, "Story Readiness Gate") {
  Container(gateway, "Gateway", "nginx", "The only door in: routes and API key")
  Container(intake, "Intake", "Node.js", "Anti-corruption layer: Jira fields stop here")
  ContainerQueue(events, "Event Log", "Redpanda", "readiness.story-changes\nreadiness.check-results")
  Container(checker, "Checker", "Node.js", "Checks the story against rules.yaml and the target's ADRs. Never calls Jira")
  Container(reporter, "Reporter", "Node.js", "Computes L0-L4. The only writer to Jira")
}

Lay_R(ba, jira)
Lay_R(jira, dev)

Rel_R(ba, jira, "Writes stories")
Rel_L(dev, jira, "Reads the board")
BiRel_D(jira, gateway, "Webhook in, level + comment out", "HTTP")
Rel_D(gateway, intake, "/webhook")
Rel_U(reporter, gateway, "Level + comment", "REST")
Rel_R(intake, events, "StoryChanged", "Kafka")
BiRel_D(events, checker, "StoryChanged in, StoryChecked out", "Kafka")
Rel_R(events, reporter, "")
Rel_L(architect, checker, "Maintains rules.yaml")

@enduml
