{
  "info": {
    "name": "Story Readiness Gate (us-enforcer)",
    "description": "The story flow, in order. Run it with the Collection Runner on a fresh stack.\nStart: docker compose up -d --build --wait\nStart over: docker compose restart jira-sim",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "jira",
      "value": "http://localhost:9000"
    },
    {
      "key": "gateway",
      "value": "http://localhost:9001"
    },
    {
      "key": "apiKey",
      "value": "dev-only-api-key"
    }
  ],
  "item": [
    {
      "name": "1. Create CR-12",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{jira}}/rest/api/v3/issue",
          "host": [
            "{{jira}}"
          ],
          "path": [
            "rest",
            "api",
            "v3",
            "issue"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"key\": \"CR-12\",\n  \"fields\": {\n    \"project\": {\n      \"key\": \"CR\"\n    },\n    \"issuetype\": {\n      \"name\": \"Change Request\"\n    },\n    \"summary\": \"Customers can reserve stock during checkout\",\n    \"status\": \"Approved\",\n    \"impactedSystems\": [\n      \"Checkout\"\n    ],\n    \"inScope\": [\n      \"reserve stock during checkout\",\n      \"release unpaid reservations\"\n    ],\n    \"outOfScope\": [\n      \"discount\",\n      \"delivery fee\"\n    ],\n    \"targetDate\": \"2026-12-15\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 201\", function () { pm.response.to.have.status(201); });"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Create NORTH-1 (weak story)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{jira}}/rest/api/v3/issue",
          "host": [
            "{{jira}}"
          ],
          "path": [
            "rest",
            "api",
            "v3",
            "issue"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"key\": \"NORTH-1\",\n  \"fields\": {\n    \"project\": {\n      \"key\": \"NORTH\"\n    },\n    \"issuetype\": {\n      \"name\": \"Story\"\n    },\n    \"summary\": \"[Cart] Reserve stock\",\n    \"asA\": \"customer\",\n    \"iWant\": \"my items reserved\",\n    \"soThat\": \"they don't sell out\",\n    \"acceptanceCriteria\": \"Stock should be reserved quickly at checkout. Reservation time TBD.\",\n    \"technicalNotes\": \"Part of CR-12.\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 201\", function () { pm.response.to.have.status(201); });"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Read NORTH-1 (L1)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{jira}}/rest/api/v3/issue/NORTH-1",
          "host": [
            "{{jira}}"
          ],
          "path": [
            "rest",
            "api",
            "v3",
            "issue",
            "NORTH-1"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Checking runs in the background: give it a moment.",
              "setTimeout(function () {}, 1500);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", function () { pm.response.to.have.status(200); });",
              "const card = pm.response.json();",
              "pm.test(\"level L1\", function () { pm.expect(card.level).to.eql(\"L1\"); });",
              "pm.test(\"8 missing items\", function () { pm.expect(card.missing.length).to.eql(8); });"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Move NORTH-1 to Ready for Dev (blocked)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{jira}}/rest/api/v3/issue/NORTH-1/transitions",
          "host": [
            "{{jira}}"
          ],
          "path": [
            "rest",
            "api",
            "v3",
            "issue",
            "NORTH-1",
            "transitions"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"to\": \"Ready for Dev\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 400\", function () { pm.response.to.have.status(400); });",
              "pm.test(\"blocked at L1\", function () { pm.expect(pm.response.json().errors.readiness).to.eql(\"L1\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Update CR-12 (add Warehouse)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{jira}}/rest/api/v3/issue/CR-12",
          "host": [
            "{{jira}}"
          ],
          "path": [
            "rest",
            "api",
            "v3",
            "issue",
            "CR-12"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fields\": {\n    \"impactedSystems\": [\n      \"Checkout\",\n      \"Warehouse\"\n    ]\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 204\", function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Update NORTH-1 (fix the story)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{jira}}/rest/api/v3/issue/NORTH-1",
          "host": [
            "{{jira}}"
          ],
          "path": [
            "rest",
            "api",
            "v3",
            "issue",
            "NORTH-1"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fields\": {\n    \"acceptanceCriteria\": \"Given an item is in my cart, When I start checkout, Then 1 unit is reserved within 2 seconds.\\nGiven a reservation is 15 minutes old, When payment has not completed, Then the unit is released.\\nGiven the item is out of stock, When I start checkout, Then I see an out-of-stock message.\",\n    \"technicalNotes\": \"Part of CR-12. Checkout publishes a StockReserved event to Warehouse. Data owner: Warehouse.\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 204\", function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Read NORTH-1 (L4)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{jira}}/rest/api/v3/issue/NORTH-1",
          "host": [
            "{{jira}}"
          ],
          "path": [
            "rest",
            "api",
            "v3",
            "issue",
            "NORTH-1"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Checking runs in the background: give it a moment.",
              "setTimeout(function () {}, 1500);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", function () { pm.response.to.have.status(200); });",
              "const card = pm.response.json();",
              "pm.test(\"level L4\", function () { pm.expect(card.level).to.eql(\"L4\"); });",
              "pm.test(\"nothing missing\", function () { pm.expect(card.missing).to.eql([]); });"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Move NORTH-1 to Ready for Dev (allowed)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{jira}}/rest/api/v3/issue/NORTH-1/transitions",
          "host": [
            "{{jira}}"
          ],
          "path": [
            "rest",
            "api",
            "v3",
            "issue",
            "NORTH-1",
            "transitions"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"to\": \"Ready for Dev\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 204\", function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Developer board (NORTH-1)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{jira}}/board",
          "host": [
            "{{jira}}"
          ],
          "path": [
            "board"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"NORTH-1 on the board\", function () { pm.expect(pm.response.json().issues.map(function (i) { return i.key; })).to.include(\"NORTH-1\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "10. Update NORTH-1 (scope creep)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{jira}}/rest/api/v3/issue/NORTH-1",
          "host": [
            "{{jira}}"
          ],
          "path": [
            "rest",
            "api",
            "v3",
            "issue",
            "NORTH-1"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fields\": {\n    \"technicalNotes\": \"Part of CR-12. Checkout publishes a StockReserved event to Warehouse. Data owner: Warehouse. Also apply a discount to reserved items.\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 204\", function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ]
    },
    {
      "name": "11. Read NORTH-1 (L3, moved back, one comment)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{jira}}/rest/api/v3/issue/NORTH-1",
          "host": [
            "{{jira}}"
          ],
          "path": [
            "rest",
            "api",
            "v3",
            "issue",
            "NORTH-1"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Checking runs in the background: give it a moment.",
              "setTimeout(function () {}, 1500);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", function () { pm.response.to.have.status(200); });",
              "const card = pm.response.json();",
              "pm.test(\"level L3\", function () { pm.expect(card.level).to.eql(\"L3\"); });",
              "pm.test(\"back in Refinement\", function () { pm.expect(card.status).to.eql(\"Refinement\"); });",
              "pm.test(\"newest comment says moved back\", function () { pm.expect(card.comments[0].body.indexOf(\"Moved back to Refinement\")).to.eql(0); });"
            ]
          }
        }
      ]
    },
    {
      "name": "12. Move NORTH-1 with an override",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{jira}}/rest/api/v3/issue/NORTH-1/transitions",
          "host": [
            "{{jira}}"
          ],
          "path": [
            "rest",
            "api",
            "v3",
            "issue",
            "NORTH-1",
            "transitions"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"to\": \"Ready for Dev\",\n  \"override\": {\n    \"by\": \"lead.architect\",\n    \"role\": \"architect\",\n    \"reason\": \"Agreed with the PO for the demo\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 204\", function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ]
    },
    {
      "name": "13. Readiness via the gateway",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Api-Key",
            "value": "{{apiKey}}"
          }
        ],
        "url": {
          "raw": "{{gateway}}/v1/stories/NORTH-1/readiness",
          "host": [
            "{{gateway}}"
          ],
          "path": [
            "v1",
            "stories",
            "NORTH-1",
            "readiness"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    }
  ]
}
