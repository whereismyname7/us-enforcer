        {
          "name": "Signed webhook, as Jira sends it (202)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Hub-Signature",
                "value": "{{webhookSignature}}"
              }
            ],
            "url": {
              "raw": "{{gateway}}/webhook",
              "host": [
                "{{gateway}}"
              ],
              "path": [
                "webhook"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{{webhookBody}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "The pre-request script builds the body and signs it with HMAC-SHA256 using webhookSecret, exactly like the simulator does."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Build the webhook body and sign it the way Jira (the simulator) does.",
                  "const body = JSON.stringify({ webhookEvent: \"jira:issue_updated\", timestamp: Date.now(), user: { accountId: \"ba.user\" }, issue: { key: \"NORTH-1\", fields: { issuetype: { name: \"Story\" }, project: { key: \"NORTH\" } } }, changelog: { items: [{ field: \"acceptanceCriteria\" }] } });",
                  "pm.variables.set(\"webhookBody\", body);",
                  "const sig = CryptoJS.HmacSHA256(body, pm.collectionVariables.get(\"webhookSecret\")).toString(CryptoJS.enc.Hex);",
                  "pm.variables.set(\"webhookSignature\", \"sha256=\" + sig);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 202\", function () { pm.response.to.have.status(202); });",
                  "pm.test(\"published one event\", function () { pm.expect(pm.response.json().published).to.eql(1); });"
                ]
              }
            }
          ]
        },
